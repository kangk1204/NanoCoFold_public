    <div class="scroll" tabindex="0" role="region" aria-label="보고서 표" data-report-i18n-attributes="aria-label"><table><caption><span data-report-i18n>지표 계산법·해석·출처</span></caption><thead><tr><th scope="col"><span data-report-i18n>모델</span></th><th scope="col"><span data-report-i18n>지표</span></th><th scope="col"><span data-report-i18n>기록 계산법</span></th><th scope="col"><span data-report-i18n>해석·한계</span></th><th scope="col"><span data-report-i18n>출처</span></th></tr></thead><tbody>
    {% for row in metric_method_rows %}<tr><td><code>{{ row.candidate_id }}</code></td><td>{{ row.metric }}</td><td><code>{{ row.recorded_method if row.recorded_method else report_term('미기록') }}</code></td><td class="original-id">{{ row.caveat if row.caveat else report_term('저자 원자 신뢰도 방식으로 기록됨') }}{% if row.status == 'legacy_variant' %}<br><code>{{ row.effective_method }}</code>{% endif %}</td><td><a href="{{ row.source }}"><span data-report-i18n>저자 코드</span></a></td></tr>{% endfor %}
    </tbody></table></div>
  </details>
