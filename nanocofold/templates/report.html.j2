  {% macro metric_caption(key, label, records) -%}
  {%- if key != 'iptm' -%}{{ label }}
  {%- else -%}
    {%- set scope_ns = namespace(scopes=[]) -%}
    {%- for row in records -%}
      {%- set scope = row.get('iptm_scope') if row.get('iptm_scope') in ['whole_complex', 'selected_target_binder_pair'] else 'unrecorded' -%}
      {%- if scope not in scope_ns.scopes -%}{%- set scope_ns.scopes = scope_ns.scopes + [scope] -%}{%- endif -%}
    {%- endfor -%}
    {{- 'ipTM · 적용 범위 혼합' if scope_ns.scopes|length > 1 else '전체 복합체 ipTM' if scope_ns.scopes == ['whole_complex'] else '표적–VHH ipTM' if scope_ns.scopes == ['selected_target_binder_pair'] else 'ipTM · 적용 범위 미기록' -}}
  {%- endif -%}
  {%- endmacro %}

  {% macro candidate_table(rows, expanded=false) %}
  {% set compact = ["selection_rank", "predictor_engine", "final_eligible", "ipsae", "iptm", "interface_plddt", "interface_pae", "n_clashes", "exclusion_reason"] %}
  <div class="scroll" tabindex="0" role="region" aria-label="보고서 표" data-report-i18n-attributes="aria-label"><table><caption><span data-report-i18n>후보·모델의 기록 점수</span></caption>
    <thead><tr><th scope="col" data-column-key="display_alias"><span data-report-i18n>후보 별칭</span></th>{% if mode != "complex" %}<th scope="col"><span data-report-i18n>결합 부위 접촉 수</span></th><th scope="col"><span data-report-i18n>지정 결합 부위 충족</span></th>{% endif %}{% for key, label in scored_columns if expanded or key in compact %}<th scope="col" data-column-key="{{ key }}">{{ report_term(metric_caption(key, label, rows)) }}</th>{% endfor %}</tr></thead>
    <tbody>{% for row in rows %}<tr>
      {% set original_id = display_identity(row) %}
      <td>{{ display_aliases.get(original_id|string, report_term('미기록')) }}</td>{% if mode != 'complex' %}{% set site = hotspot_assessment(row) %}<td>{{ report_term((site.contacted|string ~ '/' ~ site.requested|string ~ '개') if site.status not in ['not_assessed', 'not_requested', 'mapping_failed'] else '—') }}</td><td>{{ report_term(site.label) }}</td>{% endif %}
      {% for key, label in scored_columns if expanded or key in compact %}{% set v = row.get(key) %}
      <td{% if v is number and v is not boolean %} data-recorded-value="{{ v }}" title="{{ v }}" aria-describedby="report-precision"{% endif %}{% if key in ['candidate_id', 'design_id', 'variant_id'] %} class="original-id"{% endif %}>{% if key in ['candidate_id', 'design_id', 'variant_id'] and v is not none %}<details><summary><span data-report-i18n>원본 ID</span></summary><code>{{ v }}</code></details>{% elif key in ['site_satisfied', 'site_selection_eligible', 'pose_consensus_status', 'design_consistency_status', 'review_priority', 'candidate_review_priority', 'review_priority_reason'] %}{{ report_term(pose_status_label(row, key)) }}{% elif key == 'ranking_status' %}{{ report_term('순위 산정' if v == 'ranked' else '보류' if v == 'held' else '미기록') }}{% elif key == 'ranking_unavailable_reason' %}{{ report_term('예측 실패') if v == 'prediction_failed' else report_term('가중 지표 미평가') if v == 'weighted_metrics_unavailable' else report_term('가중 CDR 개발가능성 미평가') if v == 'weighted_cdr_assessment_unavailable' else report_term('접촉 없음 또는 가중 계면 지표 미평가') if v == 'interface_metrics_unavailable' else report_term('해당 없음') if not v and row.get('ranking_status') == 'ranked' else report_term('보류 이유 미기록') if not v and row.get('ranking_status') == 'held' else report_term('미평가') if not v else v }}{% elif key == 'exclusion_reason' and not v %}{{ report_term('없음' if row.get('final_eligible') is sameas true else '제외 사유 미기록' if row.get('final_eligible') is sameas false else '미평가·제외 사유 미기록') }}{% elif key in ['ipsae_scope', 'ipsae_scope_source', 'iptm_scope', 'iptm_source'] and v is not none %}<span title="{{ v }}">{{ report_term(metric_record_label(v)) }}</span>{% elif v is none %}<span class="muted"><span data-report-i18n>미평가</span></span>{% elif key == 'final_evaluated' and v is sameas true %}<span data-report-i18n>평가 완료</span>{% elif key == 'final_evaluated' and v is sameas false %}<span data-report-i18n>미평가</span>{% elif key == 'final_eligible' and v is sameas true %}<span data-report-i18n>적격</span>{% elif key == 'final_eligible' and v is sameas false %}<span data-report-i18n>부적격</span>{% elif key == 'ipsae' and mode == 'complex' %}{{ v|display_number }} <span class="muted">({{ report_term(row.get('ipsae_chain_a') ~ '–' ~ row.get('ipsae_chain_b') ~ ' 체인쌍' if row.get('ipsae_chain_a') and row.get('ipsae_chain_b') else '적용 체인 미기록') }})</span>{% elif key == 'exclusion_reason' %}{% set reason_ns = namespace(labels=[]) %}{% for reason in reason_summary if reason.code in (v|string).split(';') %}{% set reason_ns.labels = reason_ns.labels + [reason] %}{% endfor %}{% if reason_ns.labels %}{% for reason in reason_ns.labels %}{{ report_term(reason.label) if reason.code in known_reason_codes else reason.label }}{% if not loop.last %} · {% endif %}{% endfor %}{% else %}{{ report_term('기록된 제외 사유 (상세·CSV 확인)') }}{% endif %}{% elif key == 'selection_rank' and v in ['미선별', '선별 미기록', '선별 순위 미기록·대응 모호'] %}{{ report_term(v) }}{% elif v is sameas true %}<span data-report-i18n>예</span>{% elif v is sameas false %}<span data-report-i18n>아니오</span>{% else %}{{ v|display_number }}{% endif %}</td>
      {% endfor %}
    </tr>{% endfor %}</tbody>
  </table></div>
  {% endmacro %}

  <h2 id="report-models"><span data-report-i18n>03 후보 비교 · 표시</span> {{ scored_rows|length }} <span data-report-i18n>/ 전체</span> {{ scored_total }} <span data-report-i18n>후보·모델 기록</span></h2>
  <p id="report-precision" class="muted"><span data-report-i18n>숫자는 정적 보고서에서 최대 유효숫자 8자리, 결과 탐색기에서 소수 3자리로 표시합니다. 원값은 숫자 셀의 툴팁과 CSV에서 확인하세요. 순위와 적격 판정은 저장된 값을 사용합니다.</span> {% if scored_csv_available %}<a href="03_score/scored_candidates.csv"><span data-report-i18n>전체 점수 CSV</span></a>{% endif %}</p>
  <p><span data-report-i18n>예측 신뢰도와 지정 결합 부위 접촉을 함께 확인하세요. 결합 부위 상태는 미접촉·미지정·미평가로 구분합니다. PAE는 상대 위치의 불확실성, pDockQ2는 구조 품질 추정값입니다.</span></p>
